{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvpm.dev/client-config.schema.json",
  "title": "NVPM client config.yaml schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache-dir": {
          "type": "string",
          "description": "Cache directory (used when NVPM_CACHE env var is not set). Supports absolute paths, ~, or paths relative to $HOME.",
          "minLength": 1
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urls": {
          "type": "array",
          "description": "Registry zip URLs. Gets merged. Later entries take precedence over earlier ones.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cache-max-age": {
          "type": "string",
          "description": "How long the downloaded registry zip is considered fresh. Go duration string (e.g. 30m, 6h, 24h, 0).",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h|d)$|^0$"
        },
        "min-release-age": {
          "type": "string",
          "description": "Minimum age before installing/updating a newly discovered version. Uses local discovery time (not upstream timestamps). Go duration string (e.g. 7d, 168h, 0).",
          "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h|d)$|^0$"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "description": "Git-hosted package update resolution settings.",
      "properties": {
        "update-resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefers-branch-over-release": {
              "type": "object",
              "additionalProperties": false,
              "description": "When to prefer a branch tip over tags/releases as the latest version for git-hosted packages.",
              "properties": {
                "branches": {
                  "type": "array",
                  "description": "Preferred branch names, in order. If multiple exist, the tip with the newer upstream commit date wins.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "when": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "description": "always: never use tags/releases. release-age-gap: use branch when the latest tag/release is at least gap old and the branch tip is newer.",
                      "enum": ["always", "release-age-gap"]
                    },
                    "gap": {
                      "type": "string",
                      "description": "Minimum upstream age of the latest tag/release before preferring the branch tip. Required for release-age-gap. Go duration string (e.g. 60d, 1440h).",
                      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h|d)$|^0$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "description": "When to use colors/icons.",
          "enum": ["auto", "always", "never"]
        },
        "output": {
          "type": "string",
          "description": "Output format.",
          "enum": ["rich", "plain", "json"]
        }
      }
    }
  }
}
